# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8080
# Comma-separated list of allowed CORS origins, or "*" for any (dev only).
CORS_ALLOWED_ORIGINS=*
# tracing filter, e.g. "info,opd_billing_backend=debug,sqlx=warn"
RUST_LOG=info,opd_billing_backend=debug,tower_http=debug

# ----------------------------------------------------------------------------
# Database (AWS RDS for PostgreSQL)
# ----------------------------------------------------------------------------
# For RDS: postgres://<user>:<pass>@<instance>.<id>.<region>.rds.amazonaws.com:5432/<db>?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opd_billing
DATABASE_MAX_CONNECTIONS=10
# Run migrations automatically on startup (true/false)
RUN_MIGRATIONS=true

# ----------------------------------------------------------------------------
# AWS (shared)
# ----------------------------------------------------------------------------
AWS_REGION=ap-south-1
# Credentials are resolved via the default AWS chain (env, profile, IAM role).
# For local dev you may set these; in production prefer an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ----------------------------------------------------------------------------
# AWS Cognito (user registration & authentication)
# ----------------------------------------------------------------------------
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Only set if the app client has a client secret configured.
# COGNITO_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# AWS S3 (reports are stored here ONLY)
# ----------------------------------------------------------------------------
S3_REPORT_BUCKET=opd-billing-reports
# Presigned download URL validity, in seconds (default 900 = 15 min)
S3_PRESIGN_EXPIRY_SECS=900
# Max upload size for report files, in bytes (default 25 MiB)
MAX_UPLOAD_BYTES=26214400
